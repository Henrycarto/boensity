{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_TIMELINE_API_URL",
    "NEXT_PUBLIC_INGEST_API_URL",
    "NEXT_PUBLIC_SYNC_API_URL",
    "SMART_ISSUER",
    "FHIR_ISSUER",
    "FHIR_CLIENT_ID",
    "FHIR_CLIENT_SECRET",
    "FHIR_REDIRECT_URI",
    "FHIR_SCOPES",
    "EPIC_CLIENT_ID",
    "EPIC_CLIENT_SECRET",
    "EPIC_REDIRECT_URI",
    "EPIC_FHIR_BASE_URL",
    "EPIC_SCOPES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

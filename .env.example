# Copy to .env before running docker compose. Never commit the filled version.

# ---- Database ----
POSTGRES_USER=boensity
POSTGRES_PASSWORD=boensity_local_dev
POSTGRES_DB=boensity
TIMESCALE_DSN=postgresql+asyncpg://boensity:boensity_local_dev@timescaledb:5432/boensity

# ---- Redis and Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Google Cloud Vision ----
# Path inside the container. Mount the key file through docker-compose.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json
GCP_PROJECT_ID=

# ---- AWS S3 ----
AWS_REGION=eu-central-1
S3_UPLOAD_BUCKET=boensity-raw-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local dev points at MinIO. Leave blank against real AWS.
S3_ENDPOINT_URL=http://minio:9000

# ---- SMART on FHIR ----
FHIR_ISSUER=https://launch.smarthealthit.org/v/r4/fhir
FHIR_CLIENT_ID=boensity-local
FHIR_CLIENT_SECRET=
FHIR_REDIRECT_URI=http://localhost:3000/api/fhir/callback
FHIR_SCOPES=launch openid fhirUser offline_access patient/Patient.read patient/Observation.read

# ---- Service URLs consumed by the frontend ----
NEXT_PUBLIC_TIMELINE_API_URL=http://localhost:8002
NEXT_PUBLIC_INGEST_API_URL=http://localhost:8001
NEXT_PUBLIC_SYNC_API_URL=http://localhost:8003

# ---- Pharmacy portal (Boensity Sync) ----
# Live credentials are issued per pharmacy network. Without them the sync
# service runs against its recorded-response fixture driver.
PHARMACY_API_BASE_URL=
PHARMACY_API_KEY=
PHARMACY_NETWORK_ID=

# ---- Session ----
SESSION_SECRET=change_this_before_any_deployment
